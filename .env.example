# Copy this file to .env.local and fill in your values
# .env.local is gitignored via *.local pattern
VITE_UMAMI_SCRIPT_URL=
VITE_UMAMI_WEBSITE_ID=

# URL Google Apps Script Web App untuk form kehadiran acara (/kehadiran).
# Cara membuatnya ada di docs/attendance-apps-script.md
VITE_ATTENDANCE_ENDPOINT=

# URL Google Apps Script Web App untuk form lomba (/lomba & /rekap-lomba).
# Spreadsheet lomba TERPISAH dari spreadsheet IPL, jadi ini Web App yang berbeda
# dengan VITE_ATTENDANCE_ENDPOINT di atas — jangan diisi URL yang sama.
# Kalau kosong, form lomba menolak mengirim (data tidak nyasar ke sheet IPL).
# Cara membuatnya ada di docs/lomba-apps-script.md
VITE_LOMBA_ENDPOINT=
