# Copy this file to .env.local and fill in your values
# .env.local is gitignored via *.local pattern
VITE_UMAMI_SCRIPT_URL=
VITE_UMAMI_WEBSITE_ID=

# URL Google Apps Script Web App untuk form kehadiran acara (/kehadiran).
# Cara membuatnya ada di docs/attendance-apps-script.md
VITE_ATTENDANCE_ENDPOINT=

# Opsional. Endpoint khusus untuk form lomba (/lomba & /rekap-lomba).
# Dikosongkan saja bila lomba menumpang Web App yang sama dengan kehadiran —
# satu Web App melayani kedua form lewat parameter `form`.
# Detail: docs/lomba-apps-script.md
VITE_LOMBA_ENDPOINT=
