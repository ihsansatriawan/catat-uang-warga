# Salin file ini menjadi .env.local, lalu isi seperlunya.
# .env.local sudah di-gitignore.
#
# SEMUA variabel di bawah OPSIONAL — aplikasi tetap jalan kalau dibiarkan
# kosong. Identitas perumahan (nama, iuran, blok, rekening) TIDAK diatur di
# sini, melainkan di src/config/site.config.js atau lewat `npm run setup`.

# --- Analytics (opsional) --------------------------------------------------
# Umami analytics, cookieless. Kalau salah satu kosong, tag script tidak
# dipasang sama sekali. Lihat docs/analytics.md
VITE_UMAMI_SCRIPT_URL=
VITE_UMAMI_WEBSITE_ID=

# --- Form RSVP acara (opsional) -------------------------------------------
# URL Google Apps Script Web App untuk /kehadiran & /rekap-kehadiran.
# Kalau kosong, form kehadiran menampilkan pesan "belum aktif".
# Cara membuatnya: docs/attendance-apps-script.md
VITE_ATTENDANCE_ENDPOINT=

# --- Form lomba (opsional) -------------------------------------------------
# URL Google Apps Script Web App untuk /lomba & /rekap-lomba.
# Spreadsheet lomba TERPISAH dari spreadsheet iuran, jadi ini Web App yang
# berbeda dengan VITE_ATTENDANCE_ENDPOINT di atas — jangan diisi URL yang sama.
# Kalau kosong, form lomba menolak mengirim (data tidak nyasar ke sheet lain).
# Cara membuatnya: docs/lomba-apps-script.md
VITE_LOMBA_ENDPOINT=
